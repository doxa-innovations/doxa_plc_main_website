{
  "name": "doxa-global-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "payload": "PAYLOAD_CONFIG_PATH=./payload.config.ts NODE_OPTIONS=--no-deprecation payload",
    "seed:admin": "npm run payload -- run ./scripts/seed-admin.ts",
    "seed:content": "npm run payload -- run ./scripts/seed-content.ts",
    "prune:visits": "npm run payload -- run ./scripts/prune-visits.ts",
    "generate:types": "npm run payload -- generate:types",
    "migrate:create": "npm run payload -- migrate:create",
    "migrate": "npm run payload -- migrate",
    "migrate:status": "npm run payload -- migrate:status"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@payloadcms/db-postgres": "^3.87.0",
    "@payloadcms/next": "^3.87.0",
    "@payloadcms/storage-s3": "^3.87.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotted-map": "^3.1.0",
    "graphql": "^16.14.2",
    "lucide-react": "^1.18.0",
    "motion": "^12.40.0",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.4",
    "payload": "^3.87.0",
    "radix-ui": "^1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.79.0",
    "react-qr-code": "^2.2.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
