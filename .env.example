# Public site origin (no trailing slash) — used for canonical URLs, OG tags, sitemap.
NEXT_PUBLIC_SITE_URL=https://doxaplc.com

# ---------------------------------------------------------------------------
# Database (Payload CMS)
# ---------------------------------------------------------------------------
# Postgres connection string. Local dev uses the Docker container in
# docker-compose.dev.yml; production points at the Dokploy-managed instance.
# Deliberately NOT set during `docker build` — the build must succeed with no
# database reachable.
DATABASE_URI=postgres://doxa:doxa@localhost:5433/doxa_web

# Signs auth tokens and encrypts stored secrets. Long random string.
# Required at BUILD time as well as runtime: config sanitization reads it.
# Rotating this invalidates every active admin session.
PAYLOAD_SECRET=

# ---------------------------------------------------------------------------
# Contact form (Nodemailer SMTP)
# ---------------------------------------------------------------------------
DOMAIN=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Inbox that receives the "new inquiry" notification.
CONTACT_NOTIFY_TO=
# Legacy name for the same thing, used as a fallback if CONTACT_NOTIFY_TO is unset.
CONTACT_TO=company@doxaplc.com

# ---------------------------------------------------------------------------
# Media storage (Cloudflare R2, S3-compatible)
# ---------------------------------------------------------------------------
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Account endpoint, used for UPLOADS only, never for public URLs.
R2_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com
# Public origin files are served from. Must match how the custom domain is
# mapped: bucket root vs a /doxa-public prefix.
R2_PUBLIC_URL=https://cdn.doxaplc.com

# ---------------------------------------------------------------------------
# Local development helpers
# ---------------------------------------------------------------------------
# Forces a visitor country for previewing geo-gated pricing and registration
# details, e.g. FORCE_COUNTRY=ET. Leave unset in production.
FORCE_COUNTRY=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (invisible bot challenge on the contact form)
# ---------------------------------------------------------------------------
# Create a widget at dash.cloudflare.com > Turnstile, widget mode "Managed",
# with hostnames doxaplc.com, localhost and 127.0.0.1.
#
# THE HOSTNAME LIST MUST COVER EVERY HOSTNAME THE SITE IS SERVED FROM, www
# included if that is a thing. A hostname that is missing does not degrade, it
# fails hard: the widget returns error 110200 and issues no token, for every
# visitor on that hostname, so nobody can send the contact form. Adding
# localhost is what lets the challenge run against `npm run dev` at all; without
# it the local form hits the same 110200 and the widget is untestable.
#
# Set BOTH or NEITHER. With both unset the form works exactly as it does now,
# with no challenge, which is what local development runs.
#
# Note TURNSTILE_SITE_KEY has no NEXT_PUBLIC_ prefix on purpose. That prefix
# would bake the value into the JavaScript bundle at BUILD time, and the Docker
# build has no environment variables, so it would compile to an empty string
# while the server still demanded a token. The site key is read at runtime and
# passed to the form instead. It is not a secret; the browser still receives it.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare's own test keys, for trying the two paths locally:
#   always passes   site 1x00000000000000000000AA  secret 1x0000000000000000000000000000000AA
#   always fails    site 2x00000000000000000000AB  secret 2x0000000000000000000000000000000AA
